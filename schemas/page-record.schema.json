{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ukplanningguide.co.uk/schemas/page-record.schema.json",
  "title": "UK Planning Guide page record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "route_path",
    "canonical_path",
    "page_family",
    "jurisdiction",
    "authority_id",
    "project_id",
    "rule_id",
    "source_ids",
    "claims",
    "verified_at",
    "content_updated_at",
    "review_status",
    "index_status",
    "confidence",
    "unique_local_facts"
  ],
  "properties": {
    "route_path": {
      "type": "string",
      "pattern": "^/(?:$|.*/$)"
    },
    "canonical_path": {
      "type": "string",
      "pattern": "^/(?:$|.*/$)"
    },
    "page_family": {
      "enum": [
        "national_guide",
        "project_guide",
        "rule_guide",
        "authority_profile",
        "local_project",
        "local_rule",
        "tool",
        "workflow",
        "news",
        "data_report"
      ]
    },
    "jurisdiction": {
      "enum": [
        "england",
        "wales",
        "scotland",
        "northern-ireland",
        "uk"
      ]
    },
    "authority_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "rule_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "text",
          "source_ids"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "kind": {
            "enum": [
              "service_information",
              "planning_scope",
              "historical_context",
              "national_rule",
              "local_policy",
              "article4_applicability",
              "unresolved_check"
            ]
          },
          "evidence_status": {
            "enum": [
              "verified",
              "unverified"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "proposition_id"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "proposition_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "evidence_status": {
                  "const": "unverified"
                }
              },
              "required": [
                "evidence_status"
              ]
            },
            "then": {
              "properties": {
                "kind": {
                  "const": "unresolved_check"
                },
                "evidence_refs": {
                  "maxItems": 0
                }
              }
            },
            "else": {
              "properties": {
                "source_ids": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "verified_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "content_updated_at": {
      "type": "string",
      "format": "date"
    },
    "review_status": {
      "enum": [
        "draft",
        "source_checked",
        "editor_checked",
        "published"
      ]
    },
    "index_status": {
      "enum": [
        "noindex",
        "index"
      ]
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high",
        "not assessed"
      ]
    },
    "unique_local_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact",
          "source_ids"
        ],
        "properties": {
          "fact": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "kind": {
            "enum": [
              "service_information",
              "planning_scope",
              "historical_context",
              "national_rule",
              "local_policy",
              "article4_applicability",
              "unresolved_check"
            ]
          },
          "evidence_status": {
            "enum": [
              "verified",
              "unverified"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "proposition_id"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "proposition_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "evidence_status": {
                  "const": "unverified"
                }
              },
              "required": [
                "evidence_status"
              ]
            },
            "then": {
              "properties": {
                "kind": {
                  "const": "unresolved_check"
                },
                "evidence_refs": {
                  "maxItems": 0
                }
              }
            },
            "else": {
              "properties": {
                "source_ids": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "evidence_version": {
      "const": 1
    },
    "evidence_checked_at": {
      "type": "string",
      "format": "date"
    },
    "verification_scope": {
      "const": "authority_context"
    },
    "jurisdiction_support": {
      "enum": [
        "scoped",
        "unsupported"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "evidence_version"
        ]
      },
      "then": {
        "required": [
          "evidence_checked_at",
          "verification_scope",
          "jurisdiction_support"
        ],
        "properties": {
          "claims": {
            "items": {
              "required": [
                "kind",
                "evidence_status",
                "evidence_refs"
              ]
            }
          },
          "unique_local_facts": {
            "items": {
              "required": [
                "kind",
                "evidence_status",
                "evidence_refs"
              ]
            }
          }
        }
      }
    }
  ]
}
