{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ukplanningguide.co.uk/schemas/project-readiness-pack-input-v1.json",
  "title": "Project Readiness Pack input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "jurisdiction", "project_category", "authority_id", "answers", "source_snapshot"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "jurisdiction": {"enum": ["england", "scotland", "wales", "northern-ireland"]},
    "project_category": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "authority_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "answers": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean", "null"]}},
    "source_snapshot": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "checked_at"],
        "properties": {
          "source_id": {"type": "string"},
          "checked_at": {"type": "string", "format": "date"}
        }
      }
    }
  }
}
