{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ukplanningguide.co.uk/schemas/redirect-record.schema.json",
  "title": "UK Planning Guide redirect record",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_path", "target_path", "status_code", "delivery_mode", "reason"],
  "properties": {
    "source_path": {"type": "string", "pattern": "^/(?:$|.*/$)"},
    "target_path": {"type": "string", "pattern": "^/(?:$|.*/$)"},
    "status_code": {"enum": [301, 308, 410], "description": "Planned status on a supporting host; not proof of current HTTP delivery."},
    "delivery_mode": {"enum": ["legacy_200_bridge", "planned_http_redirect"]},
    "reason": {"type": "string", "minLength": 1}
  }
}
